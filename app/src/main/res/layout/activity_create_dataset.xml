<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/btnBackCreateDataset"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_button_secondary"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#E2E8F0" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dataset Design"
                android:textColor="#F8FAFC"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSaveDataset"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#2563EB"
                android:paddingHorizontal="24dp"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Form Content -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Dataset Information"
            android:textColor="#38BDF8"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDatasetName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_dark"
            android:hint="Enter name (e.g. Traffic Signs)"
            android:paddingHorizontal="16dp"
            android:textColor="#E2E8F0"
            android:textColorHint="#64748B" />

        <Spinner
            android:id="@+id/spDatasetType"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_input_dark" />

        <!-- Selection Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dashboard_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:alpha="0.8"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="#38BDF8" />

            <TextView
                android:id="@+id/tvUploadStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No images in repository"
                android:textColor="#94A3B8"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSelectImages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="#1E293B"
                android:paddingHorizontal="32dp"
                android:text="Upload Images"
                android:textAllCaps="false"
                android:textColor="#F8FAFC"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Statistics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dashboard_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTotalItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#38BDF8"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Items"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textAllCaps="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dashboard_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPendingItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FBBF24"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unlabeled"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textAllCaps="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Guidance &amp; Description"
            android:textColor="#CBD5E1"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDatasetDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_input_dark"
            android:gravity="top"
            android:hint="Explain project requirements..."
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="#E2E8F0"
            android:textColorHint="#475569" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
